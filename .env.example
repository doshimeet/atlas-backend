# Atlas Knowledge Backend Environment Configuration
PROJECT_NAME="Atlas Knowledge - World Bank Group Publications & Research Engine"
VERSION="3.2.0"
API_V1_STR="/api"

# Database Connection (SQLite local or PostgreSQL/Azure SQL)
DATABASE_URL="sqlite:///./data/atlas_knowledge.db"

# Storage Settings (local or azure)
STORAGE_PROVIDER="local"
LAKEHOUSE_DIR="./data/lakehouse"

# Azure ADLS Gen2 (Optional for enterprise deployment)
AZURE_STORAGE_ACCOUNT="atlaslakehouse"
AZURE_STORAGE_CONTAINER="wbg-knowledge-lakehouse"
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Document Parser (local or azure)
PARSER_PROVIDER="local"

# World Bank WDS API
WBG_API_BASE_URL="https://search.worldbank.org/api/v2/wds"
DEFAULT_BOOTSTRAP_ROWS=15
